# Copia questo file in `.env` (gitignored) e compila: docker compose lo legge
# automaticamente. Vedi README, sezione «Endpoint reale (tappa ⑤)».
#
# Token Bearer dell'Inference API di Hetzner (sperimentale, gratuito):
#   https://console.hetzner.com  →  Experiments Platform  →  Inference API
# Senza questa variabile il laboratorio funziona come sempre: il selettore dei
# modelli remoti in tappa ⑤ semplicemente non compare.
HETZNER_API_KEY=
